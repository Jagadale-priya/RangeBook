# Prod live — FINAL accuracy desk (NIFTY / BANKNIFTY / SENSEX)
# Copy into repo .env for local run. Dual proven/champion only.

ENABLE_STACKED_CALLS=0
ENABLE_PRE_DUAL_SINGLE=0
ENABLE_5M_CROWN=0
ENABLE_15M_CLASSIC=0
ENABLE_DAILY_FILL=0
ENABLE_NSE_MID_GATE=0
USE_DUAL_TRACK=1
PRE_DUAL_SOFT_GATES=0
OVERLAY_ACC_MIN=100
OVERLAY_NOTIFY=0

# Models resolve via prod_live.paths (frozen packs in prod_live/models/nifty/).
# Optional overrides:
# PROD_LIVE_NIFTY_PROD2=prod_live/models/nifty/prod2_15m/fno_NIFTY.pkl
# PROD_LIVE_NIFTY_CROWN=prod_live/models/nifty/crown/fno_NIFTY_crown_5m.pkl
# PROD_LIVE_NIFTY_CROWN_DIR=prod_live/models/nifty/crown
# PROD_LIVE_NIFTY_DUAL=prod_live/models/nifty/dual
