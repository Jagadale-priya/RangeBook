# Market data: Zerodha Kite Connect (primary for Indian quotes + daily history)
#
# SECRETS: prefer the Windows DPAPI vault (not plaintext here):
#   python secrets_store.py migrate
#   python secrets_store.py status
# Vault: %LOCALAPPDATA%\Rangebook\secrets\credentials.dpapi
# See docs/SECURITY.md
#
# Non-secret / flags can stay in .env:
#   KITE_REDIRECT_URL=http://127.0.0.1/
#   KITE_ENABLE=1
#   KITE_YAHOO_FALLBACK=0
#   KITE_AUTO_LOGIN=1
#
# If you have not migrated yet, these still work (then run migrate):
#   KITE_API_KEY=...
#   KITE_API_SECRET=...
#   KITE_ACCESS_TOKEN=
#   KITE_USER_ID=AB1234
#   KITE_PASSWORD=...
#   KITE_TOTP_SECRET=BASE32...

#

# Optional legacy Groww feed (off by default): GROWW_ENABLE=1 plus Groww credentials
#
# KITE_WEBSOCKET=1          # watchlist LTP via KiteTicker (default on)
# KITE_ALLOW_LIVE_ORDERS=0  # set 1 only when POST /kite/orders should execute

#

# News: NSE corporate filings + Downstox headlines (no Kite API) — unchanged

# Fundamentals / US symbols: Yahoo Finance

#

# Morning cron: scripts\morning_cron.ps1  or  python stock_signal_ml.py --morning-report

# Weekly pipeline: prefetch-all → train-watchlist → train-knowledge → optional audit
#
# ML label threshold (fraction). Default 0.006 = 0.6% next-day move.
# Separate up-head and down-head: SELL is P(drop > threshold), not "not a big up".
# TARGET_MIN_RETURN=0.006
#
# Historical audit (point-in-time replay): unset AUDIT_FAST for the live ensemble;
# AUDIT_FAST=1 uses a lighter HGB pair during --audit-watchlist.
# KITE_INTRADAY_HISTORY_DAYS=120  # minute-bar memory scan during --train-knowledge

#

# API: GET /data/kite-capabilities — Kite endpoints used vs available

# daily_fill long-term prove (shadow paper - no desk notify)
# DAILY_FILL_SHADOW=1
# DAILY_FILL_MODE=accuracy
# ENABLE_DAILY_FILL=0
# Move Capture silent-day book (shadow paper — no desk notify until pass)
# MOVE_CAPTURE_SHADOW=1
# ENABLE_MOVE_CAPTURE=0
# Optional parallel classic channel (default off)
# ENABLE_15M_CLASSIC=0
# Prod FINAL accuracy path — dual proven/champion (match root .env)
ENABLE_PRE_DUAL_SINGLE=0
USE_DUAL_TRACK=1
PRE_DUAL_SOFT_GATES=0
ENABLE_STACKED_CALLS=0
ENABLE_5M_CROWN=0
ENABLE_15M_CLASSIC=0
ENABLE_DAILY_FILL=0
OVERLAY_ACC_MIN=100
OVERLAY_NOTIFY=0
# NSE mid OFF for finalized book
ENABLE_NSE_MID_GATE=0
# Optional model path overrides (defaults: prod_live/models/nifty/...)
# PROD_LIVE_NIFTY_PROD2=prod_live/models/nifty/prod2_15m/fno_NIFTY.pkl
# PROD_LIVE_NIFTY_CROWN=prod_live/models/nifty/crown/fno_NIFTY_crown_5m.pkl
# PROD_LIVE_NIFTY_DUAL=prod_live/models/nifty/dual
